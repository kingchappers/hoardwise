aws_region     = "eu-west-2"
state_bucket   = "your-terraform-state-bucket"
# Do not change app_name on an existing deployment: the DynamoDB table name is derived from it, and a new name makes OpenTofu replace the table with an empty one. It keeps the product's old name for that reason.
app_name       = "budget-app-v3-ai-edition"
environment    = "production"
# Must match the Auth0 API Identifier the SPA requests (VITE_AUTH0_AUDIENCE).
auth0_audience = "https://your-api-identifier"

# Not read from this file in CI (see .github/workflows/yarnBuild.yml),
# only needed for local `tofu plan`/`apply`:
# auth0_domain    = "your-tenant.eu.auth0.com"
# auth0_client_id = "your-auth0-client-id"

# Bill reminders (optional). Not read from this file in CI, where it comes from the
# VAPID_PUBLIC_KEY secret; only needed for a local `tofu plan`/`apply`.
# vapid_public_key = "the public half of your VAPID key pair"

# Public origin of the app, which OAuth sign-in for assistants advertises (no path). Empty or unset disables it.
app_origin = "https://hoardwise.example.com"
